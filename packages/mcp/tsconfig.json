{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": "src",
        "module": "node16",
        "moduleResolution": "node16",
        "target": "ES2022",
        "lib": ["ES2022"],
        "composite": false,
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "declaration": false,
        "sourceMap": false
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "src/**/__tests__/**"]
}
