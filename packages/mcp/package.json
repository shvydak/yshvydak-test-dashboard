{
    "name": "@yshvydak/test-dashboard-mcp",
    "version": "0.1.0",
    "private": true,
    "description": "Read-only stdio MCP server for the YShvydak test dashboard",
    "main": "dist/index.js",
    "bin": {
        "test-dashboard-mcp": "dist/index.js"
    },
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsc",
        "test": "npx vitest run",
        "type-check": "tsc --noEmit",
        "start": "node dist/index.js",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix"
    },
    "keywords": [
        "mcp",
        "playwright",
        "dashboard"
    ],
    "author": "Yurii Shvydak <y.shvydak@gmail.com>",
    "license": "MIT",
    "dependencies": {
        "@modelcontextprotocol/server": "2.3.1",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "typescript": "^5.9.3",
        "vitest": "^3.2.4"
    }
}
