{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-architecture.sh"
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/quiet-vitest.sh"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-edited.sh"
                    }
                ]
            }
        ]
    },
    "permissions": {
        "allow": [
            "Bash(npm run dev:*)",
            "Bash(npm run build:*)",
            "Bash(npm run type-check:*)",
            "Bash(npm run lint:*)",
            "Bash(npm run lint:fix:*)",
            "Bash(npm run format:*)",
            "Bash(npm test:*)",
            "Bash(npm run test:coverage:*)",
            "Bash(npm run clear-data:*)",
            "Bash(npx vitest run:*)",
            "Bash(npx tsc:*)",
            "Bash(npx eslint:*)",
            "Bash(npx prettier:*)",
            "Bash(npm ls:*)",
            "Bash(npm why:*)",
            "Bash(turbo test:*)",
            "Bash(lsof:*)",
            "Bash(tree:*)"
        ],
        "deny": [
            "Bash(git push --force:*)",
            "Bash(git push -f:*)",
            "Read(./.env)"
        ],
        "ask": []
    }
}
