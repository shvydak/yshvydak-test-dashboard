# Copy to .env and fill in. See docs/CONFIGURATION.md for the full reference.

# --- Core (required) ---
PORT=3001                                    # API server port
NODE_ENV=development                         # development | production
PLAYWRIGHT_PROJECT_DIR=/path/to/your/tests   # Your Playwright project directory
BASE_URL=http://localhost:3001               # Base URL for all services
VITE_BASE_URL=http://localhost:3001          # Same, exposed to the web client

# --- Optional ---
# VITE_PORT=3000                             # Web dev server port (default: derived from PORT)
# OUTPUT_DIR=test-results                    # Storage directory (default: ./test-results)

# --- Auth (optional) ---
# ENABLE_AUTH=true
# JWT_SECRET=change-me-in-production
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me

# --- Jira integration (optional, all three required together) ---
# Enables read-only ticket type/status/summary/assignee on ticket-key chips (@ABC-123 tags).
# Server-side only — the token is never sent to the browser or written to logs. Leave unset and
# the dashboard behaves exactly as without this feature (plain ticket-key chips, no Jira calls).
# Separate from the "Jira base URL" set in Settings → Tags & tickets, which only builds the chip
# link and needs none of this.
# JIRA_BASE_URL=https://your-company.atlassian.net   # Site root, not /browse/
# JIRA_EMAIL=you@your-company.com                    # Atlassian account email
# JIRA_API_TOKEN=                                     # id.atlassian.com/manage-profile/security/api-tokens
